# Copy this to .env.local for local dev against the Dockerized Postgres
# (see docker-compose.yml) instead of the real Supabase DB.
#
#   cp .env.local.example .env.local
#   npm run db:up            # starts local Postgres
#   npm run db:push:local    # creates all tables from prisma/schema.prisma
#   npm run seed:local       # fills in test data
#   npm run dev:local        # runs the backend against local Postgres
#
# Auth is UNCHANGED — still verifies real Supabase-issued JWTs via JWKS,
# so sign in via the real app as usual. To see the seeded business from
# your own signed-in account, set SEED_MEMBER_USER_ID below to your real
# Supabase user UUID (Supabase dashboard → Authentication → Users) before
# running npm run seed:local — the seed script will add you as a member.

DATABASE_URL="postgresql://bahi:bahi_dev@localhost:5434/bahi_dev"
SUPABASE_JWKS_URL="https://pwumtdytjrqxmglgatmc.supabase.co/auth/v1/.well-known/jwks.json"
PORT=4000

# Optional — your real Supabase user UUID, to be added as a member of the
# seeded business so you can see it when signed into the real app.
SEED_MEMBER_USER_ID=

# Enables POST /dev/test-role — lets your real signed-in account flip its
# own role (owner/member) on the seeded business for testing. Never set
# this in the real .env / EC2 deploy secrets.
DEV_MODE=true
