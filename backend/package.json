{
  "name": "bahi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Node/Express API for Bahi — inventory management, backed by Supabase Postgres via Prisma, Supabase Auth JWT verification, Socket.IO live updates.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push:local": "dotenv -e .env.local -- prisma db push",
    "seed:local": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "dev:local": "dotenv -e .env.local -- tsx watch src/index.ts",
    "pretest": "dotenv -e .env.test -- prisma db push --force-reset --skip-generate",
    "test": "dotenv -e .env.test -- vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "jose": "^4.15.9"
  }
}
