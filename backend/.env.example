# Direct Postgres connection string (NOT the pooler) from:
# Supabase dashboard → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# JWKS discovery URL — used to verify Supabase-issued JWTs (ES256, asymmetric
# signing). From: Supabase dashboard → Settings → API → JWT Keys → Discovery URL
SUPABASE_JWKS_URL="https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"

PORT=4000
