# Transaction pooler connection string (port 6543, pgbouncer=true) — used
# by the running app for all runtime queries.
# Supabase dashboard → Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true"

# Session pooler connection string (port 5432, no pgbouncer param) — used
# ONLY by `prisma migrate`/`db push`. The transaction pooler's pgbouncer
# mode breaks the schema-engine's connection handshake (migrate commands
# hang indefinitely against port 6543); the session pooler on the same
# host doesn't have that restriction.
# Supabase dashboard → Settings → Database → Connection string → Session pooler
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres"

# JWKS discovery URL — used to verify Supabase-issued JWTs (ES256, asymmetric
# signing). From: Supabase dashboard → Settings → API → JWT Keys → Discovery URL
SUPABASE_JWKS_URL="https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"

PORT=4000
