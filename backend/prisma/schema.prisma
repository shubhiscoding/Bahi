// Prisma schema — mirrors the existing Supabase Postgres tables exactly
// (created by supabase/migrations/init_schema.sql in the Flutter project).
// This connects DIRECTLY to Postgres, bypassing PostgREST/RLS entirely —
// authorization is enforced in Express middleware instead (see src/middleware).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// profiles.id has a DB-level FK to auth.users(id) (see init_schema.sql),
// which Supabase Auth owns and populates via its own trigger. The backend
// never queries auth.users directly, so it isn't modeled here — only the
// public-schema tables the backend actually reads/writes.
model Profile {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ownedBusinesses    Business[]      @relation("BusinessOwner")
  memberships        BusinessMember[]
  editedItems        InventoryItem[] @relation("ItemEditor")
  inviteCodesUsed    InviteCode[]    @relation("InviteCodeUsedBy")
  inviteCodesCreated InviteCode[]    @relation("InviteCodeCreatedBy")
  priceHistoryEdits  InventoryPriceHistory[] @relation("PriceHistoryEditor")
  itemEditLogEntries InventoryEditLog[]      @relation("ItemEditLogEditor")
  billsCreated       Bill[]                  @relation("BillCreator")
  paymentsRecorded   BillPayment[]           @relation("BillPaymentRecorder")
  depositsRecorded   Deposit[]               @relation("DepositRecorder")

  @@map("profiles")
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner       Profile          @relation("BusinessOwner", fields: [ownerId], references: [id])
  members     BusinessMember[]
  items       InventoryItem[]
  inviteCodes InviteCode[]
  units       BusinessUnit[]
  buyers      Buyer[]
  bills       Bill[]
  deposits    Deposit[]

  @@map("businesses")
}

/// Global catalog of unit names (डिब्बा, किलो, etc.) — deduplicated across
/// businesses via the unique name, so two businesses independently adding
/// "बोरा" share the same row rather than creating duplicates.
model Unit {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  businesses BusinessUnit[]

  @@map("units")
}

/// Which units a given business has adopted — this is what the unit
/// picker actually shows per business (strictly this business's own
/// linked units, not a cross-business suggestion list — confirmed
/// requirement). Every new business gets 3 seed units linked at creation.
model BusinessUnit {
  businessId String    @map("business_id") @db.Uuid
  unitId     String    @map("unit_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Last time this unit was used on an item save for this business — drives
  // the unit picker's recency sort (Phase 7 §C). Null = never used yet.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([businessId, unitId])
  @@map("business_units")
}

/// Ephemeral, OTP-style invite codes — one row per generated code, not a
/// single column on Business. Multiple codes can be valid concurrently
/// for the same business (e.g. one generated per new hire); each is
/// independently 5-minute, single-use.
model InviteCode {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  code       String    @unique
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  usedBy     String?   @map("used_by") @db.Uuid
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  usedByProfile     Profile? @relation("InviteCodeUsedBy", fields: [usedBy], references: [id])
  createdByProfile  Profile  @relation("InviteCodeCreatedBy", fields: [createdBy], references: [id])

  @@map("invite_codes")
}

model BusinessMember {
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String // 'owner' | 'member'
  joinedAt   DateTime @default(now()) @map("joined_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([businessId, userId])
  @@map("business_members")
}

model InventoryItem {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int      @default(0)
  unit       String   @default("piece")
  updatedAt  DateTime @map("updated_at") @db.Timestamptz
  updatedBy  String   @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  editor   Profile  @relation("ItemEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  priceHistory InventoryPriceHistory[]
  editLog      InventoryEditLog[]
  billItems    BillItem[]

  @@map("inventory_items")
}

/// One row per distinct price the item has ever had — a new row is only
/// inserted when the price actually changes (create() seeds the first row;
/// update() adds one only if the new price differs from the current one).
/// Backs the price-tracker chart on the item detail screen (Phase 7 §A/§B).
model InventoryPriceHistory {
  id         String   @id @default(uuid()) @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  price      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  // Who made the change that produced this price point. Nullable — rows
  // written before this column existed have no value, no backfill
  // (matches this project's established "new writes only" precedent for
  // additive columns). SetNull rather than Restrict/Cascade since a
  // profile could in principle be removed without needing to touch old
  // history rows.
  editedBy   String?  @map("edited_by") @db.Uuid

  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  editor Profile?      @relation("PriceHistoryEditor", fields: [editedBy], references: [id], onDelete: SetNull)

  @@map("inventory_price_history")
}

/// General-purpose "what changed on this item, by whom, when" ledger —
/// broader than InventoryPriceHistory above (which stays price-only, for
/// the chart). One row per write that actually changed something.
/// Phase 8 §A — data pipe only for now, no UI consumes this yet.
model InventoryEditLog {
  id       String   @id @default(uuid()) @db.Uuid
  itemId   String   @map("item_id") @db.Uuid
  editedBy String   @map("edited_by") @db.Uuid
  editedAt DateTime @default(now()) @map("edited_at") @db.Timestamptz
  // 'edit' (manual field edit) | 'restock' (§B add-stock CTA) | 'sale'
  // (quantity decrement from billing, §D) — lets future UI distinguish
  // these without parsing `changes`.
  source   String   @default("edit")
  // { fieldName: { from, to } } for every field that actually changed —
  // e.g. { "price": { "from": "40.00", "to": "42.00" } }
  changes  Json     @db.JsonB
  // Set when source = 'sale' — which bill caused this quantity change.
  relatedBillId String? @map("related_bill_id") @db.Uuid

  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  editor Profile       @relation("ItemEditLogEditor", fields: [editedBy], references: [id], onDelete: Restrict)

  @@map("inventory_edit_log")
}

/// A named person/shop this business sells to on credit or cash — strictly
/// per-business (unlike Unit's global-catalog pattern; buyer names aren't
/// shared vocabulary, they're business-specific entities). Phase 8 §C.
model Buyer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bills    Bill[]
  deposits Deposit[]

  @@unique([businessId, name])
  @@map("buyers")
}

/// One sale/bill to a buyer, with one or more line items. Phase 8 §D.
model Bill {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  buyerId    String   @map("buyer_id") @db.Uuid
  // User-editable "sold on" date — defaults to now client-side, distinct
  // from createdAt (when the row was actually written).
  billDate   DateTime @map("bill_date") @db.Timestamptz
  // Denormalized sum of line items at creation time — same "store the
  // current value directly" style as InventoryItem.price, for cheap
  // aggregation later (buyer totals, future dashboard).
  total      Decimal  @db.Decimal(10, 2)
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  buyer    Buyer         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  creator  Profile       @relation("BillCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  items    BillItem[]
  payments BillPayment[]

  @@map("bills")
}

/// One product line on a bill. Phase 8 §D.
model BillItem {
  id       String  @id @default(uuid()) @db.Uuid
  billId   String  @map("bill_id") @db.Uuid
  itemId   String  @map("item_id") @db.Uuid
  quantity Int
  // Per-unit price AT TIME OF BILLING — defaulted from the item's current
  // price client-side, editable, never mutated after creation (a later
  // price change on the item must not retroactively alter past bills).
  price    Decimal @db.Decimal(10, 2)

  bill Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: once an item has ever been billed, deleting it
  // must fail loudly instead of silently orphaning sold-item history —
  // a deliberate behavior change from the item delete route, flagged in
  // the Phase 8 plan.
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("bill_items")
}

/// One payment against a bill — supports partial payments (multiple rows
/// per bill); due = bill.total - sum(payments.amount). Phase 8 §D.
model BillPayment {
  id         String   @id @default(uuid()) @db.Uuid
  billId     String   @map("bill_id") @db.Uuid
  amount     Decimal  @db.Decimal(10, 2)
  paidAt     DateTime @default(now()) @map("paid_at") @db.Timestamptz
  recordedBy String   @map("recorded_by") @db.Uuid
  // Which deposit event produced this row — nullable, no backfill for
  // rows written before this column existed (Phase 10, matches this
  // project's established precedent for every prior additive column).
  // `amount` here is exactly "how much of that deposit applied to this
  // specific bill" — a multi-bill deposit has several BillPayment rows
  // sharing one depositId.
  depositId  String?  @map("deposit_id") @db.Uuid

  bill     Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  recorder Profile  @relation("BillPaymentRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  deposit  Deposit? @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@map("bill_payments")
}

/// One payment EVENT — a buyer handing over money, regardless of whether
/// it settled one bill or several (Phase 10). Every payment, from either
/// bill_detail_screen's per-bill flow or buyer_detail_screen's oldest-
/// first allocation flow, wraps in exactly one Deposit. `amount` is the
/// denormalized total (= sum of this deposit's BillPayment rows).
model Deposit {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  buyerId    String   @map("buyer_id") @db.Uuid
  amount     Decimal  @db.Decimal(10, 2)
  paidAt     DateTime @default(now()) @map("paid_at") @db.Timestamptz
  recordedBy String   @map("recorded_by") @db.Uuid

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  buyer    Buyer         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  recorder Profile       @relation("DepositRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  payments BillPayment[]

  @@map("deposits")
}
