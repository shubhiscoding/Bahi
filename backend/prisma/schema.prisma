// Prisma schema — mirrors the existing Supabase Postgres tables exactly
// (created by supabase/migrations/init_schema.sql in the Flutter project).
// This connects DIRECTLY to Postgres, bypassing PostgREST/RLS entirely —
// authorization is enforced in Express middleware instead (see src/middleware).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// profiles.id has a DB-level FK to auth.users(id) (see init_schema.sql),
// which Supabase Auth owns and populates via its own trigger. The backend
// never queries auth.users directly, so it isn't modeled here — only the
// public-schema tables the backend actually reads/writes.
model Profile {
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ownedBusinesses    Business[]      @relation("BusinessOwner")
  memberships        BusinessMember[]
  editedItems        InventoryItem[] @relation("ItemEditor")
  inviteCodesUsed    InviteCode[]    @relation("InviteCodeUsedBy")
  inviteCodesCreated InviteCode[]    @relation("InviteCodeCreatedBy")

  @@map("profiles")
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner       Profile          @relation("BusinessOwner", fields: [ownerId], references: [id])
  members     BusinessMember[]
  items       InventoryItem[]
  inviteCodes InviteCode[]
  units       BusinessUnit[]

  @@map("businesses")
}

/// Global catalog of unit names (डिब्बा, किलो, etc.) — deduplicated across
/// businesses via the unique name, so two businesses independently adding
/// "बोरा" share the same row rather than creating duplicates.
model Unit {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  businesses BusinessUnit[]

  @@map("units")
}

/// Which units a given business has adopted — this is what the unit
/// picker actually shows per business (strictly this business's own
/// linked units, not a cross-business suggestion list — confirmed
/// requirement). Every new business gets 3 seed units linked at creation.
model BusinessUnit {
  businessId String    @map("business_id") @db.Uuid
  unitId     String    @map("unit_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Last time this unit was used on an item save for this business — drives
  // the unit picker's recency sort (Phase 7 §C). Null = never used yet.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([businessId, unitId])
  @@map("business_units")
}

/// Ephemeral, OTP-style invite codes — one row per generated code, not a
/// single column on Business. Multiple codes can be valid concurrently
/// for the same business (e.g. one generated per new hire); each is
/// independently 5-minute, single-use.
model InviteCode {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  code       String    @unique
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  usedAt     DateTime? @map("used_at") @db.Timestamptz
  usedBy     String?   @map("used_by") @db.Uuid
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  usedByProfile     Profile? @relation("InviteCodeUsedBy", fields: [usedBy], references: [id])
  createdByProfile  Profile  @relation("InviteCodeCreatedBy", fields: [createdBy], references: [id])

  @@map("invite_codes")
}

model BusinessMember {
  businessId String   @map("business_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String // 'owner' | 'member'
  joinedAt   DateTime @default(now()) @map("joined_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([businessId, userId])
  @@map("business_members")
}

model InventoryItem {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String
  price      Decimal  @db.Decimal(10, 2)
  quantity   Int      @default(0)
  unit       String   @default("piece")
  updatedAt  DateTime @map("updated_at") @db.Timestamptz
  updatedBy  String   @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  editor   Profile  @relation("ItemEditor", fields: [updatedBy], references: [id], onDelete: Restrict)
  priceHistory InventoryPriceHistory[]

  @@map("inventory_items")
}

/// One row per distinct price the item has ever had — a new row is only
/// inserted when the price actually changes (create() seeds the first row;
/// update() adds one only if the new price differs from the current one).
/// Backs the price-tracker chart on the item detail screen (Phase 7 §A/§B).
model InventoryPriceHistory {
  id         String   @id @default(uuid()) @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  price      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("inventory_price_history")
}
